# Optional Docker host-port overrides (container-to-container ports stay fixed)
EVALFORGE_POSTGRES_PORT=5432
EVALFORGE_REDIS_PORT=6379
EVALFORGE_BACKEND_PORT=8000
EVALFORGE_FRONTEND_PORT=5173

# Optional local authentication and operations credentials
EVALFORGE_API_KEY=
EVALFORGE_AUTH_TOKEN_PEPPER=replace-for-shared-environments
EVALFORGE_BOOTSTRAP_TOKEN=
EVALFORGE_METRICS_TOKEN=

# Provider credentials forwarded to the API and worker containers
OPENAI_API_KEY=
GROQ_API_KEY=
