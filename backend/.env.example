EVALFORGE_ENVIRONMENT=development
EVALFORGE_DATABASE_URL=postgresql+asyncpg://evalforge:evalforge@127.0.0.1:5432/evalforge
EVALFORGE_REDIS_URL=redis://127.0.0.1:6379/0
EVALFORGE_HEALTH_CHECK_TIMEOUT_SECONDS=2.0
EVALFORGE_RUN_MODE=sync
EVALFORGE_API_KEY=
EVALFORGE_AUTH_TOKEN_PEPPER=replace-for-shared-environments
EVALFORGE_BOOTSTRAP_TOKEN=
EVALFORGE_SESSION_TTL_HOURS=12
EVALFORGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EVALFORGE_ALLOWED_HOSTS=127.0.0.1,localhost,test,testserver
EVALFORGE_METRICS_TOKEN=
EVALFORGE_OTEL_SERVICE_NAME=evalforge-api
EVALFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=
EVALFORGE_OTEL_EXPORTER_OTLP_HEADERS=
EVALFORGE_SENTRY_DSN=
EVALFORGE_SENTRY_TRACES_SAMPLE_RATE=0.1
EVALFORGE_ALLOWED_ADAPTER_MODULES=app.adapters.demo_rag,app.adapters.groq_chat,app.adapters.llm_rag
EVALFORGE_LLM_ALLOWED_HOSTS=api.openai.com,api.groq.com
EVALFORGE_LLM_API_KEY_ENV_ALLOWLIST=OPENAI_API_KEY,GROQ_API_KEY
EVALFORGE_ALLOW_PRIVATE_PROVIDER_URLS=false
EVALFORGE_LLM_PROVIDER=groq
EVALFORGE_LLM_MODEL=llama-3.1-8b-instant
EVALFORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
GROQ_API_KEY=
